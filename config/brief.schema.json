{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Black Brief (data/latest.json)",
  "description": "Written by /black-brief. Only summaries, short quotes and links: never full text.",
  "type": "object",
  "required": [
    "date",
    "generated_at",
    "since",
    "episodes",
    "headlines",
    "failed_sources",
    "levity"
  ],
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "since": {
      "type": "string",
      "format": "date-time"
    },
    "failed_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "episodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/episode"
      }
    },
    "headlines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/headline"
      },
      "maxItems": 12
    },
    "levity": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/levity_item"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "episode": {
      "type": "object",
      "required": [
        "id",
        "source",
        "title",
        "url",
        "published",
        "cards",
        "quotes",
        "takeaway",
        "black_life"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "published": {
          "type": [
            "string",
            "null"
          ]
        },
        "cards": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "quotes": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/quote"
          }
        },
        "takeaway": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "black_life": {
          "type": "boolean"
        },
        "image": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "description": "Preview image URL copied from brief_input.json (loaded from the source by the app; never downloaded)"
        },
        "highlight": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40,
          "description": "One key word or short phrase from the headline/title, shown in the section color. Use on some items, not all."
        }
      }
    },
    "headline": {
      "type": "object",
      "required": [
        "id",
        "source",
        "headline",
        "url",
        "published",
        "summary",
        "black_life",
        "long_read",
        "quotes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "published": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "black_life": {
          "type": "boolean"
        },
        "long_read": {
          "type": "boolean"
        },
        "quotes": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/quote"
          }
        },
        "image": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "description": "Preview image URL copied from brief_input.json (loaded from the source by the app; never downloaded)"
        },
        "highlight": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40,
          "description": "One key word or short phrase from the headline/title, shown in the section color. Use on some items, not all."
        }
      }
    },
    "levity_item": {
      "type": "object",
      "required": [
        "id",
        "source",
        "title",
        "show",
        "platform",
        "url",
        "published"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "show": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "published": {
          "type": [
            "string",
            "null"
          ]
        },
        "image": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "description": "Preview image URL copied from brief_input.json (loaded from the source by the app; never downloaded)"
        }
      }
    },
    "quote": {
      "type": "object",
      "required": [
        "text",
        "speaker",
        "timestamp",
        "url",
        "context"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "speaker": {
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(\\d+:)?\\d{1,2}:\\d{2}$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    }
  }
}
